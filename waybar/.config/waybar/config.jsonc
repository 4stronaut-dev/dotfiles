{
  "position": "top",
  "orientation": "horizontal",
  "height": 38,
  "output": "",
  "modules-left": ["clock","group/sysmon"],
  "modules-center": ["custom/archmenu","hyprland/workspaces"],
  "modules-right": ["upower","hyprland/language",/*"group/ghub",*/"network","bluetooth","pulseaudio","custom/poweroff"],

  "custom/archmenu": {
    "format": "",
    "tooltip-format": "Arch menu\n\nLeft click: Open application launcher.",
    "on-click": "wofi --show drun"
  },

  "hyprland/workspaces":{
    "format": "[{id}]{windows}",
    "tooltip-format": "Left or Right click: activate workspace",
    "all-outputs": false,
    "on-click": "activate",
    "workspace-taskbar": {
      "enable": true,
      "update-active-window": true,
      "active-window-position": "first",
      "format": "{icon}",
      "icon-size": 18,
      "max-icons": 4,
      "on-click-window": "hyprctl dispatch 'hl.dsp.focus({ window = \"address:{address}\" })'"
    }
  },

/*  "group/ghub": {
    "id": "ghub",
    "orientation": "horizontal",
    "modules": ["custom/ghub-main", "custom/ghub-battery"]
  }, */

  "group/sysmon":{
    "orientation": "inherit",
    "modules": ["cpu", "temperature#cpu", "memory", "custom/gpu", "temperature#gpu","custom/gpu-mem"]
  },
  "cpu": {
    "interval": 5,
    "format": " {icon} 󰓅 {avg_frequency}Ghz",
    "tooltip-format": "System Monitor module/CPU/CPU Load",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },
  "temperature#cpu": {
    "interval": 5,
    "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
    "format": " {icon}{temperatureC}℃",
    "tooltip-format": "System Monitor module/CPU/CPU Tempereature",
    "format-icons": ["","","","",""]
  },
  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "tooltip-format": "System Monitor module/Memory\n\n\tUsed\t\tTotal\nMemory:\t{used}G\t/\t{total}G\nSwap:\t{swapUsed}G\t/\t{swapTotal}G"
  },
  "custom/gpu": {
    "interval": 5,
    "exec": "cat /sys/class/hwmon/hwmon2/device/gpu_busy_percent",
    "format": "󰨇 {}%",
    "tooltip-format": "System Monitor module/GPU/GPU Load"
  },
  "temperature#gpu": {
    "interval": 5,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp2_input",
    "format": " {icon}{temperatureC}℃",
    "tooltip-format": "System Monitor module/GPU/GPU Temperature",
    "format-icons": ["","","","",""]
  },
  "custom/gpu-mem": {
    "interval": 5,
    "exec": "awk '{printf \"%.2fGB\", $1/1000/1000/1000}' /sys/class/hwmon/hwmon2/device/mem_info_vram_used",
    "format": "  {}",
    "tooltip-format": "System Monitor module/GPU/GPU Memory Usage"
  },

  "clock": {
    "interval": 1,
    "format-alt": " {:%T}",
    "format": "󰃰 {:%T - %Y %b %d, %a}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "iso8601": true,
      "mode"          : "year",
      "mode-mon-col"  : 4,
      "weeks-pos"     : "left",
      "on-scroll"     : 1,
      "format": {
        "months":     "<span color='#ffead3'><b>{}</b></span>",
        "days":       "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks":      "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
        "today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions":  {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "  🇺🇸",
    "format-hu": "  🇭🇺",
    "tooltip-format": "Language module\n\nLeft click: Switch keyboard layout.\nRight click: Show key binds.",
    "on-click": "hyprctl switchxkblayout all next",
    "on-click-right": "~/.config/hypr/scripts/show-keybinds.sh"
  },

/*  "custom/ghub-main": {
    "max-length": 30,
    "exec": "~/.config/waybar/scripts/waybar-ghub-solaar.py",
    "on-scroll-up": "~/.config/waybar/scripts/waybar-ghub-solaar.py --prev",
    "on-scroll-down": "~/.config/waybar/scripts/waybar-ghub-solaar.py --next",
    "return-type": "json",
    "exec-on-event": false,
    "interval": 60,
    "signal":7,
    "format": "{text}",
    "format-alt": "{alt}",
    "tooltip": true,
    "on-click-right": "solaar 2>/dev/null"
  },
  "custom/ghub-battery": {
    "exec": "~/.config/waybar/scripts/waybar-ghub-solaar.py --battery",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "hide-empty-text": true,
    "format": " ({icon}{percentage}%)",
    "format-icons": ["󱉝","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "tooltip": false,
  },*/

  "upower": {
    "model": "Logitech PRO X",
    "format": "  {percentage}",
    "tooltip": true,
    "tooltip-format": "Power Monitor\n\nLeft click: Open Solaar mouse manager",
    "tooltip-padding": 2,
    "tooltip-spacing": 12,
    "hide-if-empty": true,
    "show-icon": true,
    "icon-size": 15,
    "on-click": "solaar 2>/dev/null"
  },

  "network": {
    "max-length": 25,
    "interval": 2,
    "format-disabled": "{icon} disabled",
    "format-disconnected": "{icon} disconnected",
    "format-linked": "{icon} {ifname} is getting IP",
    "format-ethernet": "{icon}  󰕒{bandwidthUpBits:>4}  󰇚{bandwidthDownBits:>4}",
    "format-wifi": "{icon}  󰕒{bandwidthUpBits:>4}  󰇚{bandwidthDownBits:>4}",
    "format-icons": {
      "disabled": "󰲛",
      "disconnected": "󰌙",
      "linked": "󰲐",
      "wifi": ["󰤫","󰤟","󰤢","󰤥","󰤨"],
      "ethernet": ""
    },
    "tooltip": true,
    "tooltip-format": "Network Module\n\nLeft click Open nmtui-connect\tRight-click: Open Connection Editor",
    "tooltip-format-disabled": "Network Module\n\nNetwork devices are turned OFF or not available.\n\nLeft click: Open nmtui-connect\tRight click: Open Connection Editor.",
    "tooltip-format-disconnected":"Network Module\n\nNetwork device is ON but disconnected or unplugged.\n\nLeft click: Open nmtui-connect\tRight click: Open Connection Editor.",
    "tooltip-format-ethernet": "Network Module\n\nEthernet device: {ifname}\nIP address: {ipaddr}\nGateway: {gwaddr}\n\nLeft click: Open nmtui-connect\tRight click: Open Connection Editor.",
    "tooltip-format-wifi": "Network Module\n\nWiFi device: {ifname}\nWiFi connection: {essid} @ {frequency}GHz with signal level {signalStrength}%\nIP address: {ipaddr}\nGateway: {gwaddr}\n\nLeft click: Open nmtui-connect\tRight click: Open Connection Editor.",
    "on-click": "kitty --class waybarmodule -e nmtui-connect",
    "on-click-right": "nm-connection-editor"
  },

  "bluetooth": {
    "max-length": 25,
    "format-device-preference": ["WH-1000XM5","Xbox Wireless Controller","HUAWEI P30 Pro 4stronaut"],
    "format-off": "󰂲 {status}",
    "format-disabled": "󰂲 {status}",
    "format-on": "󰂯 {status}",
    "format-connected": " [{num_connections}]:{device_alias}",
    "format-connected-battery": " [{num_connections}]:({icon} {device_battery_percentage}%) {device_alias}",
    "format-icons": ["󰥊","󰤾","󰤿","󰥀","󰥁","󰥂","󰥃","󰥄","󰥅","󰥆","󰥈"],
    "tooltip": "true",
    "tooltip-format": "Bluetooth Module.\n\nLeft click: Open Bluetooth Manager",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({icon} {device_battery_percentage}%)",
    "tooltip-format-connected": "Bluetooth Module\n\n{device_enumerate}\n\nLeft click: Open Bluetooth Manager",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "default": ["󰕿", "", ""]
    },
    "tooltip-format": "Audio Module\n\nScroll up/down: Volume up/down\nLeft click: Open Audio Manager",
    "on-click": "pavucontrol"
  },

  "custom/poweroff": {
    "format": "",
    "tooltip-format": "Power Switch Module\n\nLeft click: Power Menu\nRight click: instant Power Off",
    "on-click": "~/.config/waybar/scripts/waybar-poweroff.sh",
    "on-click-right": "hyprshutdown -t 'Shutting down...' --post-cmd 'systemctl poweroff'"
  }
}
